{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "puffinpost",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "MAIL_FROM": "RP Thread Buddy <noreply@local.test>"
    // Optional: REFRESH_FETCH_BUDGET (int, clamped 1..900, default 30). Raises the
    // per-run Tumblr fetch ceiling on a paid plan without a code change. Deliberately
    // NOT set here as a value — leave it unset so the default applies.
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threadums-local",
      // Local-only placeholder. Keep this non-deployable value in Git; use an
      // uncommitted production config with a provisioned D1 ID (see docs/beta-runbook.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SPRINT_ROOMS", "class_name": "SprintRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SprintRoom"] }
  ],
  "r2_buckets": [
    { "binding": "ICONS", "bucket_name": "threadums-icons", "remote": false }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
