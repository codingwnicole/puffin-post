{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "puffinpost",
  "main": "./dist/puffinpost/index.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "https://puffinpost.app",
    "MAIL_FROM": "Puffin Post <noreply@mail.puffinpost.app>",
    "TUMBLR_CONSUMER_KEY": "GZxE3KaRF0nfB8G0rZgIDgtRAHYZiAd9tVI3HwshzHrCCv2j3g"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threadums-production",
      "database_id": "cbd7fd9e-d78c-4f82-9184-7ae87bffe47b",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ICONS", "bucket_name": "threadums-icons-production" }
  ],
  "routes": [
    { "pattern": "puffinpost.app", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true }
}
