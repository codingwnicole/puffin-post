# Copy this file to .dev.vars for local Worker development. Never commit .dev.vars.
# Generate SESSION_SECRET and TOKEN_ENCRYPTION_KEY with a cryptographically secure 32-byte random value.
APP_ORIGIN=http://localhost:5173
MAIL_FROM=Threadums <noreply@example.com>
SESSION_SECRET=replace-with-a-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
TUMBLR_CONSUMER_KEY=replace-with-your-tumblr-oauth-consumer-key
TUMBLR_CONSUMER_SECRET=replace-with-your-tumblr-oauth-consumer-secret
RESEND_API_KEY=replace-with-your-resend-api-key
